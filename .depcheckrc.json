{
  "ignore-patterns": [
    "dist",
    "node_modules",
    "coverage",
    "artifacts",
    "packages/plugins/*/dist",
    "website/dist",
    "scripts/first-run/sdk-quickstart.mjs",
    "scripts/first-run/sdk-socket-clients.mjs",
    "scripts/first-run/sdk-stdio-child.mjs"
  ],
  "ignores": [
    "@types/*",
    "tsx",
    "vitest",
    "@eslint/*",
    "eslint",
    "typescript-eslint",
    "eslint-plugin-import-x",
    "globals",
    "prettier",
    "lint-staged",
    "@cyclonedx/cyclonedx-npm",
    "license-checker-rseidelsohn",
    "depcheck",
    "dependency-cruiser"
  ],
  "skip-missing": false
}
