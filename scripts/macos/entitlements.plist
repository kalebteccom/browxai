<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the bundled Node binary in the signed macOS app (RFC 0012).

  release-app.sh applies this file to the executable named `node` only. The
  launcher and every other Mach-O file in the bundle is signed with the hardened
  runtime and no entitlements.

  Start with allow-jit alone. V8 maps its code pages with MAP_JIT, and the
  hardened runtime refuses that without this key. Add the next key only after a
  signed build crashes on a Mac without it, and write the crash into the RFC:

    com.apple.security.cs.allow-unsigned-executable-memory
        only if the build fails to start or crashes on a WebAssembly or
        regular-expression path with allow-jit set.

    com.apple.security.cs.disable-library-validation
        only if a native addon or a dylib signed by another team has to load.
        The production dependencies are plain JavaScript today, so this one is
        expected to stay out.

  Never add com.apple.security.get-task-allow: notarization rejects it.
  The App Sandbox key (com.apple.security.app-sandbox) stays out too, because the
  daemon starts browsers and adb.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
