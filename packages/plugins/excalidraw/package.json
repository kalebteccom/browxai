{
  "name": "@browxai/plugin-excalidraw",
  "version": "0.1.2",
  "description": "Excalidraw canvas-app adapter plugin for browxai: scene, viewport, add, delete and scroll over the `window.excalidrawAPI` page-side global.",
  "author": "Kalebtec",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "browxai",
    "browxai-plugin",
    "excalidraw",
    "canvas",
    "mcp",
    "browser-automation",
    "ai-agent"
  ],
  "homepage": "https://browxai.com/plugins/first-party/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalebteccom/browxai.git",
    "directory": "packages/plugins/excalidraw"
  },
  "bugs": {
    "url": "https://github.com/kalebteccom/browxai/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./schema.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.d.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "browxai": {
    "apiVersion": "1.0.0",
    "browxaiVersion": ">=0.14.0",
    "namespace": "excalidraw",
    "register": "dist/index.js",
    "capabilities": [
      "eval",
      "canvas"
    ],
    "trust": "kalebtec",
    "dependsOn": []
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  }
}
