# Response headers for the docs site. Netlify reads this file from the publish
# directory, so it applies to CLI deploys (`pnpm docs:deploy` runs from /tmp and
# never sees netlify.toml) as well as Git-based builds. Keep it in step with the
# [[headers]] blocks in netlify.toml; test/scripts/netlify-headers.test.ts checks that.

# Content-hashed assets never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Shot filenames carry a content hash.
/shots/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
