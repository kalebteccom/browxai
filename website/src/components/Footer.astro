---
// Wraps Starlight's default footer (prev/next, edit link, last updated) and
// adds a site-wide credit line with the version, licence and package links.
import Default from "@astrojs/starlight/components/Footer.astro";
import { LICENSE_URL, NPM_URL, REPO_URL, packageVersion } from "../lib/package-info";
const version = packageVersion();
---

<Default><slot /></Default>

<nav class="browx-credit" aria-label="Footer">
  browxai{version && ` v${version}`}
  <span class="sep" aria-hidden="true">·</span>
  <a href={LICENSE_URL}>MIT licensed</a>
  <span class="sep" aria-hidden="true">·</span>
  <a href={REPO_URL}>GitHub</a>
  <span class="sep" aria-hidden="true">·</span>
  <a href={NPM_URL}>npm</a>
  <span class="sep" aria-hidden="true">·</span>
  Made by <a href="https://kalebtec.com">Kalebtec</a>
</nav>

<script>
  // The footer renders on every page, so this is the one place that loads the
  // docs-page enhancements (click-to-copy inline code, focusable wide tables).
  import "../scripts/docs-enhance";
</script>
