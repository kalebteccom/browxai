---
// Wraps Starlight's head and preloads the three font files the first paint
// needs: Inter 400 (body) and Poppins 600 and 700 (headings and the site
// title). The ?url imports resolve to the same hashed files the @fontsource
// CSS points at, so the browser fetches each once. The @font-face rules keep
// font-display: swap.
import Default from "@astrojs/starlight/components/Head.astro";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import poppins600 from "@fontsource/poppins/files/poppins-latin-600-normal.woff2?url";
import poppins700 from "@fontsource/poppins/files/poppins-latin-700-normal.woff2?url";

const fonts = [inter400, poppins600, poppins700];
---

<Default {...Astro.props}><slot /></Default>
{
  fonts.map((href) => (
    <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
  ))
}
