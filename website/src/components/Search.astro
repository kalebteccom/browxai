---
// Wraps Starlight's search button. The visible text is "Search" plus the "Ctrl K"
// shortcut hint, and the accessible name is "Search" alone, so the visible text is
// not fully in the name (WCAG 2.5.3, the Lighthouse label-content-name-mismatch
// audit; hiding the hint with aria-hidden did not satisfy it). The script sets the
// name to the visible text once Starlight's own script has written the hint.
import Default from "@astrojs/starlight/components/Search.astro";
---

<Default {...Astro.props}><slot /></Default>
<script is:inline>
  addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("site-search button[data-open-modal]").forEach((button) => {
      const visible = button.textContent.replace(/\s+/g, " ").trim();
      if (visible) button.setAttribute("aria-label", visible);
    });
  });
</script>
